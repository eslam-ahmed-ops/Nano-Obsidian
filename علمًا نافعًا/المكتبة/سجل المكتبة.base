views:
  - type: list
    name: Table
    filters:
      and:
        - file.folder == "علمًا نافعًا/المكتبة/سجل المكتبة"
    order:
      - file.name
      - status
      - category
      - rating
      - author
      - started
      - completed
      - حالة
      - تقييم
      - الكاتب
      - tags
      - النوع
      - سن
      - نوع
    indentProperties: true
